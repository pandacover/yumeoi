{
	"name": "yumeoi-test",
	"main": "test/worker.ts",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"vars": {
		"AI_GATEWAY_ID": "default",
		"YUMEOI_API_KEY": "ym_test_key",
		"YUMEOI_USER_ID": "test-user",
		"CLERK_TEST_USER_ID": "test-user",
		"TOKEN_ENCRYPTION_KEY": "test-token-key-32-bytes-long!!"
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "local-oauth-kv-test"
		}
	],
	"r2_buckets": [
		{
			"binding": "DOCS",
			"bucket_name": "yumeoi-docs-test"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "yumeoi-test",
			"database_id": "local-yumeoi-test",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "MemoryAgent",
				"class_name": "MemoryAgent"
			},
			{
				"name": "SourceAgent",
				"class_name": "SourceAgent"
			}
		]
	},
	"workflows": [
		{
			"name": "ingest-workflow",
			"binding": "INGEST_WORKFLOW",
			"class_name": "IngestWorkflow"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["MemoryAgent"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["SourceAgent"]
		}
	]
}
