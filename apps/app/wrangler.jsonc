{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "yumeoi",
	"main": "src/server.ts",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		"AI_GATEWAY_ID": "default"
	},
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "yumeoi-memories"
		}
	],
	"r2_buckets": [
		{
			"binding": "DOCS",
			"bucket_name": "yumeoi-docs"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "yumeoi",
			"database_id": "local-yumeoi",
			"preview_database_id": "local-yumeoi-preview",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "MemoryAgent",
				"class_name": "MemoryAgent"
			},
			{
				"name": "SourceAgent",
				"class_name": "SourceAgent"
			}
		]
	},
	"workflows": [
		{
			"name": "ingest-workflow",
			"binding": "INGEST_WORKFLOW",
			"class_name": "IngestWorkflow"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["MemoryAgent"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["SourceAgent"]
		}
	]
}
