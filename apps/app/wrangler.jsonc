{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "yumeoi",
	"main": "src/server.ts",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		"AI_GATEWAY_ID": "default"
	},
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "yumeoi-memories"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "MemoryAgent",
				"class_name": "MemoryAgent"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["MemoryAgent"]
		}
	]
}
